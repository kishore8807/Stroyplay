{
  "name": "storyplay",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev --prefix server\" \"vite\"",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "npm run start --prefix server",
    "test": "npm test --prefix server"
  },
  "dependencies": {
    "opencode-token-optimizer": "^0.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.0.1",
    "oxlint": "^1.90.0",
    "vite": "^8.3.6"
  }
}
